# Firebase client SDK config — see lib/firebase.ts. Not read by any page yet in Phase 1.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Source Code (sourcecode.co.ke) bulk SMS gateway — used by lib/sms.ts to
# send phone-verification codes on /auth. Get the key from the portal:
# Developers/API > Show API Key (requires your account password).
SOURCECODE_API_KEY=
SOURCECODE_SENDER_ID=NAVAC
SOURCECODE_SERVICE_ID=0

# Signs and verifies OTP tokens (lib/otp.ts) — generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and never change it in production without invalidating in-flight codes.
OTP_SIGNING_SECRET=

# TaifaPay (merchants.taifapay.africa) hosted checkout — used by /shop and
# /checkout for real payments (M-Pesa, card, bank). Sandbox and production
# are separate credentials/hosts; TAIFAPAY_ENV picks which this deploy uses
# and defaults to sandbox. Generate credentials from the merchant dashboard:
# NAVAC company > API Integration > Create Client Credential (once for the
# Sandbox toggle, once for Live).
# Password staff use to sign in at /admin (a single shared password, not
# individual accounts — Phase 1). Generate one and set it as a Firebase
# App Hosting secret; never commit the real value.
ADMIN_PASSWORD=

TAIFAPAY_ENV=sandbox
TAIFAPAY_SANDBOX_CLIENT_ID=
TAIFAPAY_SANDBOX_CLIENT_SECRET=
TAIFAPAY_PRODUCTION_CLIENT_ID=
TAIFAPAY_PRODUCTION_CLIENT_SECRET=

# TaifaPay webhook (docs: merchants.taifapay.africa/docs/guides/webhooks) —
# verifies the X-Webhook-Signature on deliveries to
# /api/webhooks/taifapay. Register that route's full URL and this same
# secret in the merchant dashboard's webhook settings.
TAIFAPAY_WEBHOOK_SECRET=

# Used to build the TaifaPay returnUrl and any other absolute links this
# server generates. Falls back to the incoming request's own origin if unset.
NEXT_PUBLIC_SITE_URL=https://ashok.navac.co.ke

# Resend (resend.com) — transactional email for the /booking form (new
# booking notification to the business, confirmation to the customer).
# Get RESEND_API_KEY from resend.com/api-keys. EMAIL_FROM must be an
# address on a domain verified in Resend's Domains tab, or sending fails.
# BOOKING_NOTIFY_EMAIL defaults to siteConfig.email if unset.
RESEND_API_KEY=
EMAIL_FROM=
BOOKING_NOTIFY_EMAIL=

# Custom suit engine (/custom-suits) — display-only USD conversion rate.
# Everything is charged in KES; USD prices are shown as approximate.
NEXT_PUBLIC_KES_PER_USD=129

# ---- Local development only (ignored by any production build) ----------
# TAIFAPAY_ENV=mock   → in-memory payment gateway with a stand-in hosted page
#                       at /dev/mock-pay, so checkout → payment → reconcile
#                       can be tested without TaifaPay credentials.
# ASHOK_FAKE_FIRESTORE=1 → in-memory Firestore (lib/dev/fake-firestore.ts)
#                       for running without GCP credentials; optionally
#                       persisted with ASHOK_FAKE_FIRESTORE_FILE=.dev-firestore.json
# Both are hard-gated to NODE_ENV !== "production".
